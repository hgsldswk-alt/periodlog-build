{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经期记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經期記錄"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经你允许，读取苹果健康中的经期、体温与相关记录，导入到本机。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your permission, import period, temperature, and related records from Apple Health to this phone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經你允許，讀取 Apple 健康中的經期、體溫與相關紀錄，匯入到本機。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经你允许，把你选择的经期与相关记录保存到苹果健康。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your permission, save the period and related records you choose to Apple Health."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經你允許，將你選擇的經期與相關紀錄儲存至 Apple 健康。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证身份后解锁你的本地经期记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity to unlock your local period records."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證身分後解鎖你的本機經期紀錄。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
