{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经期记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經期記錄"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理記録"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생리주기 기록장"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zyklustagebuch"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diario Menstrual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menstruação"
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经你允许，读取苹果健康中的经期、体温与相关记录，导入到本机。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your permission, import period, temperature, and related records from Apple Health to this phone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經你允許，讀取 Apple 健康中的經期、體溫與相關紀錄，匯入到本機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可いただいた場合に、ヘルスケアの生理・体温などの記録を読み取り、この端末に取り込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 건강 앱의 생리·체온 등 기록을 읽어 이 기기로 가져옵니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du es erlaubst, werden Perioden-, Temperatur- und ähnliche Einträge aus Health auf dieses Gerät importiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo permites, se importan a este dispositivo los registros de periodo, temperatura y similares de Salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ton autorisation, importe les règles, la température et les données associées depuis Santé d’Apple vers ce téléphone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com sua permissão, importa do app Saúde para este celular os registros de menstruação, temperatura e afins."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经你允许，把你选择的经期与相关记录保存到苹果健康。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your permission, save the period and related records you choose to Apple Health."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經你允許，將你選擇的經期與相關紀錄儲存至 Apple 健康。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可いただいた場合に、選んだ生理などの記録をヘルスケアに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용하면 고른 생리 등 기록을 건강 앱에 저장합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du es erlaubst, werden ausgewählte Periodeneinträge in Health gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo permites, los registros de periodo que elijas se guardan en Salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ton autorisation, enregistre dans Santé d’Apple les règles et données associées que tu choisis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com sua permissão, salva no app Saúde os registros de menstruação e afins que você escolher."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证身份后解锁你的本地经期记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify your identity to unlock your local period records."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證身分後解鎖你的本機經期紀錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認のうえ、端末内の生理記録のロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인 확인 후 기기 안의 생리 기록 잠금을 해제합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperrt nach deiner Bestätigung die Periodeneinträge auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea los registros menstruales de este dispositivo tras confirmar que eres tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie ton identité pour déverrouiller tes données de règles locales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme sua identidade para desbloquear seus registros menstruais locais."
          }
        }
      }
    }
  },
  "version": "1.0"
}
