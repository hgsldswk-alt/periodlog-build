    "预测仅供参考，不能用于避孕。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测仅供参考，不能用于避孕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Predictions are for reference only. Do not use them for contraception."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預測僅供參考，不能用於避孕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測は参考用です。避妊には使わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측은 참고용입니다. 피임에 쓰지 마세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhersagen dienen nur zur Orientierung. Nutze sie nicht zur Verhütung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las predicciones son solo de referencia. No las uses como anticonceptivo."
          }
        }
      }
    },
    "预测会显示大约范围，不需要记得很精确。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测会显示大约范围，不需要记得很精确。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Predictions show an approximate range. You don’t need to remember exact dates."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預測會顯示大約范圍，不需要記得很精確。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測はおおよその範囲で表示します。正確な日付を覚えておく必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측은 대략적인 범위로 보여 줍니다. 정확한 날짜를 기억할 필요가 없어요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhersagen zeigen einen ungefähren Bereich. Du musst dir keine genauen Daten merken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las predicciones muestran un rango aproximado. No necesitas recordar fechas exactas."
          }
        }
      }
    },
    "预测基于你的记录，仅供参考，也不能用于避孕。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测基于你的记录，仅供参考，也不能用于避孕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Predictions are based on your records and are for reference only. Do not use them for contraception."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預測依據你的記錄，僅供參考，也不能用於避孕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測はあなたの記録にもとづく参考情報です。避妊には使わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측은 내 기록을 바탕으로 한 참고용입니다. 피임에 쓰지 마세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhersagen beruhen auf deinen Einträgen und dienen nur zur Orientierung. Nutze sie nicht zur Verhütung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las predicciones se basan en tus registros y son solo de referencia. No las uses como anticonceptivo."
          }
        }
      }
    },
