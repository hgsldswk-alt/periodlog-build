    "请保管好密码，忘记后无法恢复加密备份。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保管好密码，忘记后无法恢复加密备份。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your password safe. An encrypted backup can’t be recovered without it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保管好密碼，忘記後無法恢復加密備份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードは大切に保管してください。暗号化したバックアップはパスワードがないと復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호를 잘 보관하세요. 암호화한 백업은 비밀번호 없이 복구할 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre dein Passwort gut auf. Ein verschlüsseltes Backup lässt sich ohne Passwort nicht wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda bien tu contraseña. Una copia cifrada no se puede recuperar sin ella."
          }
        }
      }
    },
    "请先在系统设置中设置设备密码。": {
