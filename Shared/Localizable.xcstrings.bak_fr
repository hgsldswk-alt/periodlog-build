    "不用注册 · 没有广告 · 数据只在手机里": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用注册 · 没有广告 · 数据只在手机里"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account · No ads · Records stay on your phone"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用注冊 · 沒有廣告 · 資料只在手機里"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント不要 · 広告なし · 記録は端末内だけ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 없음 · 광고 없음 · 기록은 휴대폰에만"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto · Keine Werbung · Einträge bleiben auf dem Handy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta · Sin anuncios · Los registros se quedan en tu teléfono"
          }
        }
      }
    },
    "不用注册。记录保存在你的手机。每一步都可以跳过。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用注册。记录保存在你的手机。每一步都可以跳过。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account needed. Your records stay on your phone. You can skip any step."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用注冊。紀錄儲存在你的手機。每一步都可以跳過。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントは不要です。記録は端末内だけに保存されます。どのステップもスキップできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 필요 없습니다. 기록은 휴대폰에 남습니다. 어떤 단계든 건너뛸 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Konto nötig. Deine Einträge bleiben auf deinem Handy. Du kannst jeden Schritt überspringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No necesitas cuenta. Tus registros se quedan en tu teléfono. Puedes omitir cualquier paso."
          }
        }
      }
    },
