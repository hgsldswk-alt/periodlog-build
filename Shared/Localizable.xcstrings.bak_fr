          }
        }
      }
    },
    "一个很干净的经期记录 App，不用注册、没有广告，数据只存在自己手机里。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个很干净的经期记录 App，不用注册、没有广告，数据只存在自己手机里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A simple period tracker with no account and no ads. Your records stay on your own phone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個很干凈的經期紀錄 App，不用注冊、沒有廣告，資料只存在自己手機里。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント不要・広告なしのシンプルな生理管理。記録はあなたの端末の中だけに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정도 광고도 없는 간단한 생리 기록 앱. 기록은 내 휴대폰에만 남습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einfacher Periodenkalender ohne Konto und ohne Werbung. Deine Einträge bleiben auf deinem eigenen Handy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un calendario menstrual sencillo, sin cuenta y sin anuncios. Tus registros se quedan en tu propio teléfono."
          }
        }
      }
    },
