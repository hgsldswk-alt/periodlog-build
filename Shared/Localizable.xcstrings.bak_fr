    },
    "未授权或同步失败，其余记录功能照常可用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授权或同步失败，其余记录功能照常可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access wasn’t granted or sync failed. You can keep using all other logging features."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未授權或同步失敗，其余紀錄功能照常可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスが許可されていないか、同期に失敗しました。ほかの記録機能はすべて使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근이 허용되지 않았거나 동기화에 실패했습니다. 다른 기록 기능은 계속 쓸 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff erteilt oder Sync fehlgeschlagen. Alle anderen Funktionen zum Eintragen kannst du weiter nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se dio acceso o falló la sincronización. Puedes seguir usando las demás funciones de registro."
          }
        }
      }
    },
    "未授权；不给权限也能正常记录。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授权；不给权限也能正常记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not authorized. You can still track without access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未授權；不給權限也能正常紀錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されていません。許可しなくても記録は続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 없습니다. 접근 없이도 기록할 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht berechtigt. Du kannst auch ohne Zugriff eintragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin autorización. Aún puedes registrar sin dar acceso."
          }
        }
      }
    },
    "未来日期只能查看预测。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来日期只能查看预测。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Future dates show predictions only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未來日期只能查看預測。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未来の日付は予測のみ表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미래 날짜에는 예측만 표시됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Künftige Tage zeigen nur Vorhersagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas futuras solo muestran predicciones."
          }
        }
      }
    },
    "未能保留原文件，暂未导入。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能保留原文件，暂未导入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t preserve the original file. Nothing has been imported."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能保留原檔案，暫未匯入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルを保持できなかったため、何も取り込んでいません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일을 보존하지 못했습니다. 아무것도 가져오지 않았습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originaldatei konnte nicht gesichert werden. Es wurde nichts importiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conservar el archivo original. No se importó nada."
          }
        }
      }
    },
    "未能删除苹果健康里的记录，本地记录已删除。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
