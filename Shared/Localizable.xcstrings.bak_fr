    "提醒只在本机安排。打开 App 后会自动更新后续提醒。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒只在本机安排。打开 App 后会自动更新后续提醒。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders are scheduled on this phone. Opening the app refreshes upcoming reminders."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒只在本機安排。打開 App 後會自動更新後續提醒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知はこの端末で予約されます。アプリを開くと今後の通知が更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림은 이 휴대폰에서 예약됩니다. 앱을 열면 다가오는 알림이 새로 고쳐집니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen werden auf diesem Handy geplant. Beim Öffnen der App werden anstehende Erinnerungen aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios se programan en este teléfono. Al abrir la app se actualizan los próximos."
          }
        }
      }
    },
