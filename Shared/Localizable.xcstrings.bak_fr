    "口令永远不包含历史记录、易孕期、症状或体温。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口令永远不包含历史记录、易孕期、症状或体温。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes never include history, fertile windows, symptoms, or temperature."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "口令永遠不包含歷史紀錄、易孕期、癥狀或體溫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードには履歴、妊娠しやすい時期、症状、体温は一切含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드에는 기록, 가임기, 증상, 체온이 절대 들어가지 않습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codes enthalten nie Verlauf, fruchtbare Tage, Symptome oder Temperatur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos nunca incluyen historial, días fértiles, síntomas ni temperatura."
          }
        }
      }
    },
