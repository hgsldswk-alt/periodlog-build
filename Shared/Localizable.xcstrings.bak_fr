    "记录、预测、日历、CSV、备份、面容锁与亲友口令永远免费。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录、预测、日历、CSV、备份、面容锁与亲友口令永远免费。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logging, predictions, the calendar, CSV and backup files, app lock, and friend codes are always free."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "紀錄、預測、日曆、CSV、備份、面容鎖與親友口令永遠免費。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録、予測、カレンダー、CSVとバックアップファイル、アプリのロック、友だちコードはずっと無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록, 예측, 달력, CSV와 백업 파일, 앱 잠금, 친구 코드는 언제나 무료입니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge, Vorhersagen, Kalender, CSV- und Backup-Dateien, App-Sperre und Freundes-Codes sind immer gratis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro, las predicciones, el calendario, los archivos CSV y de copia, el bloqueo de la app y los códigos de amiga siempre son gratis."
          }
        }
      }
    },
