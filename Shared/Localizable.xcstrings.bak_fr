    "默认关闭。开启后存在你自己的 iCloud，我们看不到。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。开启后存在你自己的 iCloud，我们看不到。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Backups are stored in your own iCloud, where we cannot see them."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。開啟後存在你自己的 iCloud，我們看不到。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期設定はオフです。バックアップはあなた自身のiCloudに保存され、開発者が見ることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본은 꺼짐. 백업은 내 iCloud에 저장되며 저희는 볼 수 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Backups liegen in deiner eigenen iCloud, wo wir sie nicht sehen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Las copias se guardan en tu propio iCloud, donde no podemos verlas."
          }
        }
      }
    },
