    "无法读取文件，请选择有效的经期备份。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取文件，请选择有效的经期备份。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the file. Choose a valid Period backup."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取檔案，請選擇有效的經期備份。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めませんでした。正しいバックアップファイルを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽지 못했습니다. 올바른 생리 기록 백업을 고르세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei konnte nicht gelesen werden. Wähle ein gültiges Perioden-Backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo. Elige una copia válida de Periodo."
          }
        }
      }
    },
    "无法读取本地文件，原文件已保留。请重新打开 App，或从备份恢复。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取本地文件，原文件已保留。请重新打开 App，或从备份恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the local file. The original is preserved. Reopen the app or restore a backup."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取本地檔案，原檔案已保留。請重新打開 App，或從備份恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内のファイルを読み込めませんでした。元のファイルは保持されています。アプリを開き直すか、バックアップを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 파일을 읽지 못했습니다. 원본은 보존되었습니다. 앱을 다시 열거나 백업을 복원하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Datei konnte nicht gelesen werden. Das Original bleibt erhalten. Öffne die App erneut oder stelle ein Backup wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo local. El original se conservó. Vuelve a abrir la app o restaura una copia."
          }
        }
      }
    },
    "无法读取这个备份，文件可能已损坏或版本不支持。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这个备份，文件可能已损坏或版本不支持。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read this backup. It may be damaged or from an unsupported version."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取這個備份，檔案可能已損壞或版本不支持。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップを読み込めませんでした。壊れているか、対応していないバージョンの可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업을 읽지 못했습니다. 손상되었거나 지원하지 않는 버전일 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup konnte nicht gelesen werden. Es ist vielleicht beschädigt oder stammt aus einer nicht unterstützten Version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer esta copia. Puede estar dañada o ser de una versión no compatible."
          }
        }
      }
    },
