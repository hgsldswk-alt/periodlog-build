    "高级体验已结束。记录永远免费，已建吃药提醒照常。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级体验已结束。记录永远免费，已建吃药提醒照常。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your advanced trial has ended. Logging is always free, and existing pill reminders continue."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高級體驗已結束。紀錄永遠免費，已建吃藥提醒照常。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度な機能のお試しが終了しました。記録はずっと無料で、設定済みのピル通知も続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고급 기능 체험이 끝났습니다. 기록은 언제나 무료이고 기존 피임약 알림은 계속됩니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Test der erweiterten Funktionen ist beendet. Eintragen ist immer gratis, und bestehende Pillen-Erinnerungen laufen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba de funciones avanzadas terminó. El registro siempre es gratis y los recordatorios de píldora existentes continúan."
          }
        }
      }
    },
