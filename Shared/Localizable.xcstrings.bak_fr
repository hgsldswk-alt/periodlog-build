    "原文件已保留。请先恢复备份，避免覆盖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件已保留。请先恢复备份，避免覆盖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file is preserved. Restore a backup before making changes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原檔案已保留。請先恢復備份，避免覆蓋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルは保持されています。変更する前にバックアップを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일은 보존되었습니다. 변경하기 전에 백업을 복원하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originaldatei bleibt erhalten. Stelle ein Backup wieder her, bevor du etwas änderst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo original se conservó. Restaura una copia antes de hacer cambios."
          }
        }
      }
    },
