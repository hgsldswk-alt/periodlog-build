          }
        }
      }
    },
    "对方添加口令后，可以在自己的手机上开启提醒。不经过任何服务器。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方添加口令后，可以在自己的手机上开启提醒。不经过任何服务器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After adding your code, they can enable reminders on their phone. No server is involved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方添加口令後，可以在自己的手機上開啟提醒。不經過任何服務器。"
          }
        }
      }
    },
    "导入": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入"
          }
        }
      }
    },
    "导入会合并记录，同一天以导入文件为准。本机为空时还会恢复设置与提醒；购买、锁和系统权限不会被覆盖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入会合并记录，同一天以导入文件为准。本机为空时还会恢复设置与提醒；购买、锁和系统权限不会被覆盖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries are merged, with imported entries replacing matching days. If this phone has no entries, preferences and reminders are also restored. Purchases, locks, and system permissions stay unchanged."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入會合併紀錄，同一天以匯入檔案為準。本機為空時還會還原設定與提醒；購買、鎖和系統權限不會被覆蓋。"
          }
        }
      }
    },
